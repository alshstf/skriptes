    {
      "key": "birth-1925",
      "date": {
        "from": "1925-10-11",
        "precision": "day"
      },
      "type": "birth",
      "tier": "major",
      "short": "Рождение в Новом Орлеане",
      "long": "Родился в Новом Орлеане в семье Флоры Амелии (урождённой Рив) и Элмора Джона Леонарда; отец работал землемером в General Motors.",
      "place": {
        "label": "Новый Орлеан"
      },
      "chapter": "detroit-childhood",
      "evidence": {
        "source": "enwiki",
        "quote": "Elmore John Leonard Jr. (October 11, 1925 – August 20, 2013)"
      }
    },
    {
      "key": "relocation-1934",
      "date": {
        "from": "1934",
        "precision": "year"
      },
      "type": "relocation",
      "tier": "major",
      "short": "Переезд семьи в Детройт",
      "long": "После нескольких лет частых переездов, связанных с работой отца, семья осела в Детройте. Газетные новости тех лет — гангстеры Бонни и Клайд, бейсбольные «Тигры» — повлияли на многие его книги.",
      "place": {
        "label": "Детройт"
      },
      "chapter": "detroit-childhood",
      "evidence": {
        "source": "enwiki",
        "quote": "Because his father worked as a site locator for General Motors, the family moved frequently for several years. In 1934, the family settled in Detroit."
      }
    },
    {
      "key": "war-1943",
      "date": {
        "from": "1943",
        "to": "1946",
        "precision": "year"
      },
      "type": "war",
      "tier": "major",
      "short": "Служба во флоте в Тихом океане",
      "long": "После школы в 1943 году, будучи отклонён морской пехотой из-за зрения, поступил во флот; три года служил в строительных частях «Си-Биз» на юге Тихого океана.",
      "place": {
        "label": "Тихий океан"
      },
      "chapter": "navy-university",
      "evidence": {
        "source": "enwiki",
        "quote": "He graduated from the University of Detroit Jesuit High School in 1943 and, after being rejected for the Marines for weak eyesight, immediately joined the Navy, where he served with the Seabees for three years in the South Pacific"
      }
    },
    {
      "key": "education-1946",
      "date": {
        "from": "1946",
        "precision": "year"
      },
      "type": "education",
      "tier": "minor",
      "short": "Учёба в Детройтском университете",
      "long": "Поступил в Детройтский университет по закону о льготах для ветеранов и стал всерьёз заниматься сочинительством: участвовал в конкурсах и рассылал рассказы в журналы.",
      "place": {
        "label": "Детройт"
      },
      "chapter": "navy-university",
      "evidence": {
        "source": "enwiki",
        "quote": "Enrolling at the University of Detroit in 1946, on the G.I. Bill, he pursued writing more seriously"
      }
    },
    {
      "key": "love-1949",
      "date": {
        "from": "1949",
        "precision": "year"
      },
      "type": "love",
      "tier": "major",
      "short": "Брак с Беверли Клайн",
      "long": "Женился на Беверли Клэр Клайн; в этом браке родились пятеро детей — две дочери и трое сыновей.",
      "chapter": "navy-university",
      "evidence": {
        "source": "enwiki",
        "quote": "He married Beverly Clare Cline in 1949 and had five children with her"
      }
    },
    {
      "key": "education-1950",
      "date": {
        "from": "1950",
        "precision": "year"
      },
      "type": "education",
      "tier": "minor",
      "short": "Окончание университета",
      "long": "Окончил университет со степенью бакалавра по английскому языку и философии; год до этого устроился копирайтером в рекламное агентство Campbell-Ewald.",
      "place": {
        "label": "Детройт"
      },
      "chapter": "navy-university",
      "evidence": {
        "source": "enwiki",
        "quote": "He graduated in 1950 with a bachelor's degree in English and philosophy."
      }
    },
    {
      "key": "career-1951",
      "date": {
        "from": "1951",
        "precision": "year"
      },
      "type": "career",
      "tier": "minor",
      "short": "Первый успех в журнале Argosy",
      "long": "Журнал Argosy опубликовал его рассказ о вестерне; в 1950-х и начале 1960-х он написал более 30 рассказов, работая параллельно в рекламе.",
      "works": [
        {
          "ref": "the-bounty-hunters"
        }
      ],
      "chapter": "ads-westerns",
      "evidence": {
        "source": "enwiki",
        "quote": "Leonard had his first success in 1951 when Argosy magazine published his short story"
      }
    },
    {
      "key": "career-1969",
      "date": {
        "from": "1969",
        "precision": "year"
      },
      "type": "career",
      "tier": "major",
      "short": "Переход от вестернов к криминальной прозе",
      "long": "Вышел первый криминальный роман Леонарда; после вестернов он стал специализироваться на криминальной прозе, где диалоги и характеры занимали его больше мелодрамы.",
      "works": [
        {
          "ref": "the-big-bounce"
        }
      ],
      "chapter": "crime-turn",
      "evidence": {
        "source": "enwiki",
        "quote": "In 1969, his first crime story, The Big Bounce, was published by Gold Medal Books."
      }
    },
