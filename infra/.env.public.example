# ════════════════════════════════════════════════════════════════════════
#  .env для ПУБЛИЧНОГО (DMZ) деплоя skriptes — доступ из интернета без VPN.
#
#  Запуск (release + хардненинг-overlay с публичным Caddyfile):
#    docker compose -f docker-compose.release.yml \
#                   -f docker-compose.harden.yml \
#                   --env-file .env up -d
#  Рядом с compose-файлами должны лежать Caddyfile и Caddyfile.public.
#
#  Схема: роутер пробрасывает 443 и 80 на этот хост; Caddy сам получает
#  сертификат Let's Encrypt для SKRIPTES_HOST. Хост — ИЗОЛИРОВАННЫЙ (отдельная
#  VM/VLAN, из него нет доступа в домашнюю сеть).
#  Отличия от обычного .env.example прокомментированы как  ⚠ DMZ.
# ════════════════════════════════════════════════════════════════════════

# ── общее ───────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=skriptes
TZ=Europe/Moscow

# ── PostgreSQL ──────────────────────────────────────────────────
# ⚠ DMZ: НЕ дефолтные. Своя БД на DMZ-хосте, изолирована от homelab.
POSTGRES_USER=skriptes
POSTGRES_PASSWORD=__СГЕНЕРИРУЙ_СИЛЬНЫЙ__   # openssl rand -base64 24
POSTGRES_DB=skriptes

# ── Meilisearch ─────────────────────────────────────────────────
# ⚠ DMZ: в проде master-key ОБЯЗАТЕЛЕН (иначе индекс открыт по сети контейнеров).
MEILI_MASTER_KEY=__СГЕНЕРИРУЙ_СИЛЬНЫЙ__    # openssl rand -base64 32
MEILI_ENV=production

# ── Backend ─────────────────────────────────────────────────────
SKRIPTES_HTTP_ADDR=:8080
SKRIPTES_LOG_LEVEL=info
SKRIPTES_LOG_FORMAT=json
# ⚠ DMZ: пин конкретной версии (не latest) — воспроизводимость деплоя.
SKRIPTES_VERSION=1.11.0

# ── Внешнее обогащение ──────────────────────────────────────────
# Ключи — отдельные от домашнего инстанса (у каждого своя квота). Пусто — источник
# работает анонимно (Google Books) или выключен (TMDB-постеры).
SKRIPTES_GOOGLE_BOOKS_API_KEY=
SKRIPTES_TMDB_API_KEY=

# ── Auth / cookies ──────────────────────────────────────────────
# ⚠ DMZ: TLS терминирует Caddy → cookie только по HTTPS.
SKRIPTES_COOKIE_SECURE=true
# ⚠ DMZ: ваш публичный домен (A-запись на внешний IP).
SKRIPTES_COOKIE_DOMAIN=skriptes.example.com
# ⚠ DMZ: origin = публичный https-домен (CSRF: мутирующие запросы только оттуда).
SKRIPTES_ALLOWED_ORIGINS=https://skriptes.example.com
# Анти-брутфорс: лимит НЕУДАЧНЫХ попыток входа на окно (IP 5мин / email 15мин).
# Общий для формы логина и OPDS. ⚠ DMZ: ОСТАВИТЬ включённым.
SKRIPTES_LOGIN_RATELIMIT_IP=10
SKRIPTES_LOGIN_RATELIMIT_EMAIL=20
# ⚠ DMZ: false. IP клиента backend берёт из X-Forwarded-For, который выставляет
# Caddy. true — только если к бэкенду ходят исключительно через Cloudflare.
SKRIPTES_TRUST_CF_CONNECTING_IP=false

# ── Volumes (read-only данные) ──────────────────────────────────
# ⚠ DMZ: ЛОКАЛЬНЫЕ пути на DMZ-хосте. Лучше всего — односторонняя копия, которую
# запускает LAN. Сетевой mount с домашнего NAS (NFS/SMB) — это путь из
# интернет-фейсинг хоста в LAN; если без него никак — только read-only, отдельный
# низкопривилегированный пользователь и firewall к одному порту NAS.
BOOKS_HOST_PATH=/srv/skriptes/books
INPX_HOST_PATH=/srv/skriptes/inpx

# ── Send-to-Kindle / SMTP (опц.) ───────────────────────────────
# Если нужен Send-to-Kindle на публичном инстансе — задайте SMTP (app-password).
SKRIPTES_SMTP_HOST=
SKRIPTES_SMTP_PORT=587
SKRIPTES_SMTP_USER=
SKRIPTES_SMTP_PASSWORD=
SKRIPTES_SMTP_FROM=
SKRIPTES_SMTP_USE_TLS=false

# ── Caddy / hostname ────────────────────────────────────────────
# ⚠ DMZ: публичное имя. Caddy получит для него сертификат Let's Encrypt — нужна
# A-запись на внешний IP и проброс 443 (и 80) с роутера на этот хост.
# Если DNS у Cloudflare — запись в режиме «DNS only» (без прокси).
SKRIPTES_HOST=skriptes.example.com
HTTP_PORT=80
HTTPS_PORT=443
